+/* CLOVER: one-line collapsible toolbar. Everything (Undo/Redo included) lives in the scrollable strip.
+   Layout: [spacer][toggle][strip]. Collapsed: the spacer grows so the lone toggle sits at the far right
+   and the strip is width 0. Expanded: the spacer shrinks to 0, the toggle glides to the far left and the
+   strip unrolls to its right. flex-grow and max-width are both animated, so it is one continuous motion. */
+#toolbar-wrap { display: flex; flex-wrap: wrap; align-items: stretch; }
+#toolbar-wrap > .table-context-bar { flex: 1 0 100%; }   /* the table bar keeps its own full row above the strip */
+.clover-spacer { flex: 0 1 0px; transition: flex-grow 0.25s ease; }
+#toolbar-wrap.clover-collapsed .clover-spacer { flex-grow: 1; }
+#toolbar-wrap > #toolbar { flex: 1 1 0px; min-width: 0; max-width: 100%; opacity: 1; transition: max-width 0.25s ease, opacity 0.2s ease, padding 0.25s ease; }   /* CLOVER: basis 0 — with basis:auto the strip's content width made it wrap onto its own line under flex-wrap */
+#toolbar-wrap.clover-collapsed > #toolbar { flex-grow: 0; max-width: 0; opacity: 0; overflow: hidden; padding-left: 0; padding-right: 0; pointer-events: none; }
+.clover-pin { flex: 0 0 auto; overflow: visible; }
+#toolbar-wrap { border-top: none; }   /* CLOVER: no hairline above the toolbar row */
+.clover-expander {
+  width: 30px; height: 30px; padding: 0; border-radius: 15px;
+  display: flex; align-items: center; justify-content: center;
+  background: rgba(128,128,128,0.12);
+}
+.clover-expander:active { background: rgba(128,128,128,0.24); }
+.clover-expander svg, .clover-expander img { width: 16px; height: 16px; transition: transform 0.25s ease; }
+#toolbar-wrap:not(.clover-collapsed) .clover-expander svg,
+#toolbar-wrap:not(.clover-collapsed) .clover-expander img { transform: rotate(180deg); }
