+<script>
+/* CLOVER: one-line collapsible toolbar — see the CLOVER CSS block. The toggle is the only chrome in the
+   collapsed state (far right); expanding slides it to the far left and unrolls the full strip, Undo/Redo
+   first. Undo/Redo stay ordinary #toolbar buttons, so the active-state refresh keeps handling them. */
+(function () {
+  try {
+    const wrap = document.getElementById('toolbar-wrap');
+    const bar = document.getElementById('toolbar');
+    if (!wrap || !bar) return;
+    // Core state first — even if anything below throws, the bar starts collapsed with a visible toggle.
+    const spacer = document.createElement('div');
+    spacer.className = 'clover-spacer';
+    const pin = document.createElement('div');
+    pin.className = 'toolbar clover-pin';
+    const x = document.createElement('button');
+    x.type = 'button';
+    x.className = 'clover-expander';
+    x.title = 'More';
+    x._isActive = () => false;
+    x.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="12.5 17 7.5 12 12.5 7"/><polyline points="18 17 13 12 18 7"/></svg>';
+    x.addEventListener('click', (e) => { e.preventDefault(); wrap.classList.toggle('clover-collapsed'); });
+    pin.appendChild(x);
+    wrap.insertBefore(pin, bar);
+    wrap.insertBefore(spacer, pin);
+    wrap.classList.add('clover-collapsed');
+    // Undo/Redo become the first tools of the strip.
+    const lead = Array.from(bar.querySelectorAll('button')).filter(b => b.title === 'Undo' || b.title === 'Redo');
+    for (const b of lead.reverse()) bar.insertBefore(b, bar.firstChild);
+    // Custom artwork: drop clover-toggle.svg (or .png) next to editor.html to replace the built-in icon.
+    (function tryCustomIcon(names) {
+      if (!names.length) return;
+      const img = new Image();
+      img.onload = () => { x.textContent = ''; x.appendChild(img); };
+      img.onerror = () => tryCustomIcon(names.slice(1));
+      img.alt = '';
+      img.src = names[0];
+    })(['clover-toggle.svg', 'clover-toggle.png']);
+  } catch (e) {
+    try { window.webkit.messageHandlers.debugLog.postMessage('CLOVER toolbar init failed: ' + (e && e.message ? e.message : e)); } catch (_) {}
+  }
+})();
+</script>
